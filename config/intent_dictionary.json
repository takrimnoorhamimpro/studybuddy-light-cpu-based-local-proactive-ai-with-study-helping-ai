  "intents": [
    {
      "id": "complete_task",
      "label": "mark an existing task as complete",
      "keyword_groups": [
        [
          "task",
          "tasks",
          "todo",
          "to-do",
          "assignment"
        ],
        [
          "complete",
          "completed",
          "finish",
          "finished",
          "done",
          "mark as complete",
          "mark complete",
          "mark done"
        ]
      ],
      "exclude_phrases": [
        "what is a task",
        "how do i complete",
        "how to complete",
        "task completed means",
        "i completed my assignment yesterday",
        "what was the task i completed",
        "what task did i complete",
        "what tasks have i completed",
        "which task did i complete",
        "how many tasks have i completed",
        "show completed tasks",
        "list completed tasks",
        "my completed tasks"
      ],
      "direct_patterns": [
        "(?i)\\b(?:complete|finish|done with)\\s+(?:the\\s+)?task\\s*[:=\\-]\\s*\\S+",
        "(?i)\\b(?:complete|finish)\\s+(?:the\\s+)?task\\s+.+",
        "(?i)\\bmark\\s+as\\s+complete\\s*[:=\\-]\\s*\\S+",
        "(?i)\\bmark\\s+(?:the\\s+)?task\\s+.+\\s+(?:complete|done)\\b",
        "(?i)\\b(?:complete|finish)\\s+(?:this|that|the last)\\s+task\\b",
        "(?i)\\bmark\\s+as\\s+complete\\s+whatever\\s+in\\s+my\\s+tasks\\b"
      ],
      "confirm_prompt": "It sounds like you may want to mark an existing task as complete. Is that right? Reply YES or NO.",
      "details_prompt": "Here are your open tasks. Reply with a number or the exact task title you want to complete.",
      "no_items_prompt": "You don't have any open tasks to complete.",
      "retry_prompt": "I couldn't match that to one open task. Reply with the number or exact task title shown above, or say CANCEL.",
      "help_example": "Finish / mark complete + task title"
    },
    {
      "id": "add_task",
      "label": "add a task",
      "keyword_groups": [
        [
          "add",
          "create",
          "make",
          "put",
          "save",
          "include",
          "jot down"
        ],
        [
          "task",
          "tasks",
          "todo",
          "to-do",
          "task list"
        ]
      ],
      "exclude_phrases": [
        "what is a task",
        "how to add tasks",
        "how do i add a task",
        "don't add a task",
        "do not add a task",
        "not add a task"
      ],
      "direct_patterns": [
        "(?i)\\b(?:add|create|make|put|save)\\s+(?:a\\s+|the\\s+)?(?:task|todo|to-do)\\s*[:=\\-]\\s*\\S+",
        "(?i)\\b(?:add|create|make|put|save)\\s+(?:a\\s+|the\\s+)?(?:task|todo|to-do)\\s+(?:called|named|to|for)\\s+\\S+",
        "(?i)\\b(?:add|put|save)\\s+.+\\s+(?:to|on|in|into)\\s+(?:my\\s+)?(?:task list|tasks|todo list|to-do list)\\b",
        "(?i)\\b(?:add|create)\\s+(?:the\\s+)?task\\s+.+",
        "(?i)\\b(?:add|put|save)\\s+(?:it\\s+)?(?:to|in|into)\\s+(?:my\\s+)?(?:task|tasks|task list|todo list|to-do list)\\s*[:=\\-]\\s*\\S+"
      ],
      "confirm_prompt": "It sounds like you may want to add a task. Is that right? Reply YES or NO.",
      "details_prompt": "What task should I add? You can include an optional due date. Example: Finish physics assignment; due 2026-10-27 17:00. The due date must use YYYY-MM-DD or YYYY-MM-DD HH:MM.",
      "retry_prompt": "Please send the task title, optionally followed by '; due YYYY-MM-DD HH:MM', or say CANCEL.",
      "help_example": "Finish physics assignment; due 2026-10-27 17:00"
    },
    {
      "id": "set_reminder",
      "label": "set a reminder",
      "keyword_groups": [
        [
          "set",
          "create",
          "make",
          "add",
          "remind me",
          "nudge me",
          "notify me",
          "need",
          "want",
          "would like",
          "can you",
          "could you",
          "please remind"
